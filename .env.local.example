NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. From Supabase Project
# Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Kajabi Public API credentials (Settings → Public API in Kajabi).
KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=
KAJABI_SITE_ID=2147637375

# Any random string. Stops anyone else from triggering the membership
# sync by hitting its URL directly. Vercel sends this automatically as
# a Bearer token when the cron job runs.
CRON_SECRET=
